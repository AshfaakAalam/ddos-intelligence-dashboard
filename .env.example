# Create a Cloudflare API token with the required Radar read permissions.
API_TOKEN=replace_with_your_cloudflare_api_token

# Use a long random value in production.

# API polling is deliberately rate-limited to at least 60 seconds; default is 5 minutes.
POLL_INTERVAL_SECONDS=300
CLOUDFLARE_TIMEOUT_SECONDS=20
CLOUDFLARE_DATE_RANGE=1d
CLOUDFLARE_NORMALIZATION=PERCENTAGE
# Cloudflare Radar defaults to 5 results; request up to 1000 (API may return fewer).
CLOUDFLARE_LIMIT=1000

# Optional. Defaults to a SQLite database at ./ddos.db.
# DATABASE_URL=sqlite:////absolute/path/to/ddos.db
# COOKIE_SECURE=false
